#!/usr/bin/env bash
# hdajack-profile — desktop-audio integration guard for sof-hda-dsp.
#
# One loop, ONE source of truth per concern. Handles every failure mode
# observed live on this Alder Lake / AN515-58 (Fedora 44, PipeWire 1.6.8):
#
#   F1 jack plug/unplug is invisible   — UCM profiles are exclusive
#        (Speaker OR Headphones); a late plug never raises a port event,
#        so we re-pick the matching profile from kernel jack state.
#   F2 profile races to 'off'/'pro-audio' after external switches —
#        WirePlumber's restore policy is applied around us; set → settle
#        → RE-ASSERT beats the race, and drift is healed every tick.
#   F3 route volume regressions on every relink (1.0 → 0.60 observed) —
#        hardware analog sinks pinned to 1.0 every tick. Loudness lives in
#        one place: the EasyEffects virtual sink that Fn keys/widget drive.
#   F4 effect chains latch onto nodes removed by profile switches —
#        EasyEffects is try-restarted whenever the profile truly changed.
#
# Output discipline: user-visible events go to syslog (-t hdajack-profile);
# per-tick enforcement is silent when idempotent. Parsing rule learned the
# hard way: wpctl status embeds box-drawing chars and '*' around IDs —
# always tr -cd '0-9' after extraction; wpctl errors are never trusted.
set -u

CARDNAME=alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic
HP_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)"
SP_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
HEAL_LOG=/tmp/nitro-jack-watch.log   # rolling trace of enforcement actions

find_card() {
    for c in /proc/asound/card[0-9]*; do
        [ -d "$c" ] || continue
        idx=${c#/proc/asound/card}
        if amixer -c "$idx" contents 2>/dev/null | grep -q "name='Headphone Jack'"; then
            echo "$idx"; return 0
        fi
    done
    return 1
}

jack_state() {
    local v
    v=$(amixer -c "$1" contents 2>/dev/null | grep -A2 "name='Headphone Jack'")
    case $v in
        *values=on*)  echo on  ;;
        *values=off*) echo off ;;
    esac
}

active_profile() {
    pactl -f json list cards 2>/dev/null | python3 -c '
import json,sys
for c in json.load(sys.stdin):
    if "skl_hda_dsp_generic" in c.get("name",""):
        print(c.get("active_profile","") or "off")
        break
' 2>/dev/null
}

# F3: sink locator — parse survives the box chars and the '*' default marker
hw_sink_id() {
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' \
        | grep " $1 \[" | cut -d. -f1 | tr -cd '0-9'
}

# Mirror state integration: the Plasma widget mutates EXACTLY ONE device
# (the selected/default one). With the EQ chain there are two devices
# (virtual EE sink + hardware), and a stream may sit pointed directly at
# hardware — then widget mute says MUTED while the speaker keeps playing
# (observed live). Mirror the default sink's volume AND mute onto the
# hardware analog sinks every tick so any bypassing stream obeys the
# widget too.
mirror_default_state() {
    # 1) the device the widget actually controls = the '*' default sink
    local defaultsid line dvol=1.0 dmute=false nm hw hvol hmute
    defaultsid=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' \
        | grep '\*' | cut -d. -f1 | tr -cd '0-9' | head -1)
    [ -n "$defaultsid" ] || return 0
    line=$(wpctl get-volume "$defaultsid" 2>/dev/null)
    case $line in
        *MUTED*) dmute=true ;;
    esac
    dvol=$(echo "$line" | sed -e 's/.*Volume: //' -e 's/ \[.*//')
    case $dvol in ''|*[!0-9.]*) dvol=1.0 ;; esac
    # 2) mirror onto hardware analog sinks (0=unmute, 1=mute for wpctl)
    for nm in Speaker Headphones; do
        hw=$(hw_sink_id "$nm"); [ -n "$hw" ] || continue
        hline=$(wpctl get-volume "$hw" 2>/dev/null)
        hvol=$(echo "$hline" | sed -e 's/.*Volume: //' -e 's/ \[.*//')
        case $hline in ''|*[!0-9.]*) hvol=1.0 ;; esac
        hmute=false
        case $hline in *MUTED*) hmute=true ;; esac
        if ! awk "BEGIN{exit !($hvol == $dvol)}"; then
            wpctl set-volume "$hw" "$dvol" 2>/dev/null \
                && echo "$(date '+%m%d %H:%M') mirror $nm vol $hvol → $dvol" >> "$HEAL_LOG"
        fi
        if [ "$hmute" != "$dmute" ]; then
            wpctl set-mute "$hw" "$( $dmute && echo 1 || echo 0 )" 2>/dev/null \
                && echo "$(date '+%m%d %H:%M') mirror $nm mute $hmute → $dmute" >> "$HEAL_LOG"
        fi
    done
}

assert_profile() {  # set, let ports settle, re-assert (F2 race)
    local want=$1
    if ! pactl set-card-profile "$CARDNAME" "$want" 2>/dev/null; then
        return 1
    fi
    sleep 2
    pactl set-card-profile "$CARDNAME" "$want" 2>/dev/null
    echo "$(date '+%m%d %H:%M') profile → $want" >> "$HEAL_LOG"
    return 0
}

[[ -f $HEAL_LOG ]] || : > "$HEAL_LOG"

last=""
while :; do
    state=""
    if idx=$(find_card); then
        state=$(jack_state "$idx")
    fi

    if [ -n "$state" ] && [ "$state" != "$last" ]; then
        case $state in
            on)  want=$HP_PROFILE ;;
            off) want=$SP_PROFILE ;;
        esac
        if assert_profile "$want"; then
            logger -t hdajack-profile "jack $state → $want"
            systemctl --user try-restart easyeffects.service 2>/dev/null   # F4
        fi
        last=$state
    fi

    # F2 + F3 per-tick: heal silent drift the same way, minus the restart
    if [ -n "$state" ]; then
        case $state in
            on)  want=$HP_PROFILE ;;
            off) want=$SP_PROFILE ;;
        esac
        cur=$(active_profile)
        if [ "$cur" != "$want" ]; then
            if assert_profile "$want"; then
                logger -t hdajack-profile "drift heal: was '${cur:-off}'"
                systemctl --user try-restart easyeffects.service 2>/dev/null
            fi
        fi
        mirror_default_state    # supersedes pin_hw_volume: owns both volume + mute
    fi

    sleep 3
done
