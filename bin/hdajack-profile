#!/usr/bin/env bash
# hdajack-profile — keep the HDA card profile in sync with the 3.5mm jack.
# Why this exists: this codec's profiles are exclusive (Speaker OR Headphones)
# and PipeWire only picks a profile at device init. A headset plugged in AFTER
# boot never triggers a profile switch (the jack port doesn't exist inside the
# Speaker profile) → "headset not showing up". This watcher polls the kernel
# Headphone Jack state and applies the matching profile.
set -u
find_card() {
  # the sof-hda analog card (has 'Headphone Jack' switch); index can change per boot
  for c in /proc/asound/card[0-9]*; do
    [ -d "$c" ] || continue
    idx=${c#/proc/asound/card}
    if amixer -c "$idx" contents 2>/dev/null | grep -q "name='Headphone Jack'"; then
      echo "$idx"
      return 0
    fi
  done
  return 1
}
HP_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)"
SP_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
CARDNAME=alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic

last=""
while :; do
  idx=$(find_card)
  state=""
  if [ -n "$idx" ]; then
    v=$(amixer -c "$idx" contents 2>/dev/null | grep -A2 "name='Headphone Jack'")
    case $v in
      *values=on*)  state=on  ;;
      *values=off*) state=off ;;
    esac
  fi
  if [ -n "$state" ] && [ "$state" != "$last" ]; then
    want=""
    case $state in
      on)  want=$HP_PROFILE ;;
      off) want=$SP_PROFILE ;;
    esac
    # Set profile, wait for the port settle, then re-assert — WirePlumber's
    # own restore-policy race can shove the card onto the raw pro-audio
    # profile right after ours; the second write wins that race.
    pactl set-card-profile "$CARDNAME" "$want" 2>/dev/null \
      && logger -t hdajack-profile "jack $state → profile $want"
    sleep 2
    pactl set-card-profile "$CARDNAME" "$want" 2>/dev/null
    # Rebind EasyEffects to the (new) default hardware node — after a
    # profile switch its sink may still target the vanished one
    # (observed: silence after unplug with EE alive and bound to HP node).
    systemctl --user try-restart easyeffects.service 2>/dev/null
    last=$state
  fi
  sleep 3
done
