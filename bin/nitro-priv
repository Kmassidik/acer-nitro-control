#!/bin/bash
# nitro-priv — whitelisted root helper for nitro-control (via sudoers NOPASSWD)
# sudoers authorizes ONLY these exact argument forms; validation here is
# defense-in-depth and must fail closed:
#   nitro-priv thermal on | off
#   nitro-priv cpu GOV EPP TURBO      (fixed tokens; TURBO is 0|1)
set -u
_chain=""
_p=$$
for _i in 1 2 3 4 5; do
  _ppid=$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d " ")
  [ -z "$_ppid" ] && break
  _chain="$_chain<$(ps -o comm= -p "$_ppid" 2>/dev/null)"
  _p="$_ppid"
done
logger -t nitro-priv "invoked: $* from:$_chain"

fail() { logger -t nitro-priv "rejected: $*"; exit 2; }

write_all() { # $1=sysfs filename  $2=value
  local rc=0 f
  for f in /sys/devices/system/cpu/cpu*/cpufreq/"$1"; do
    echo "$2" > "$f" 2>/dev/null || rc=1
  done
  [ "$rc" -eq 0 ] || logger -t nitro-priv "WARN: some writes to $1 failed"
  return $rc
}

case "$1" in
  profile)
    # profile quiet|balanced|lowpower — thermal-profile engine (WMI misc
    # setting NitroSense drives). THIS is the quiet knob on Jimny_ADH:
    # gaming fan-mode "auto" pins a ~3300 RPM floor (measured), while the
    # profile engine idles at ~1800 RPM and re-inits (0 RPM dip) on switch.
    case "$2" in
      quiet) P=quiet ;;
      balanced) P=balanced ;;
      lowpower) P=low-power ;;
      *) fail "profile '$2'" ;;
    esac
    F=/sys/firmware/acpi/platform_profile
    if [ ! -e "$F" ]; then logger -t nitro-priv "profile: $F missing"; exit 3; fi
    echo "$P" > "$F" || fail "write $F=$P"
    logger -t nitro-priv "profile -> $P"
    exit 0
    ;;
  fanmode)
    # fanmode auto|turbo — Gaming fan-behavior engine via facer sysfs
    # (the AN515-58 Jimny_ADH firmware ignores raw EC duty registers; the
    # WMI fan-behavior call behind the Predator turbo button is the only
    # fan-noise control the EC honors — exposed as gaming_fan_mode).
    case "$2" in
      auto) M=1 ;;
      turbo) M=2 ;;
      *) fail "fanmode '$2'" ;;
    esac
    F=/sys/devices/platform/acer-wmi/gaming_fan_mode
    if [ ! -w "$F" ]; then logger -t nitro-priv "fanmode: $F missing (facer predator_v4 not active)"; exit 3; fi
    echo "$M" > "$F" || fail "write $F"
    logger -t nitro-priv "fanmode -> $M"
    exit 0
    ;;
  fan)
    # fan <pct|auto|status|cpu PCT|gpu PCT> — direct EC fan engine
    # Manual duty paths ride the QUIET profile: the duty floor is
    # profile-dependent (quiet ≈1800 RPM, balanced ≈3260 measured) — this
    # gives sliders the full 1800→7500 range. Auto leaves the profile alone.
    fan_manual_profile() { echo quiet > /sys/firmware/acpi/platform_profile 2>/dev/null || true; }
    case "$2" in
      auto|status)
        [ "$#" -eq 2 ] || fail "fan argc=$#"
        exec /usr/local/libexec/nitro-fan "$2"
        ;;
      cpu|gpu)
        [ "$#" -eq 3 ] || fail "fan $2 argc=$#"
        case "$3" in
          ''|*[!0-9]*) fail "fan pct '$3'" ;;
        esac
        fan_manual_profile
        [ "$3" -le 100 ] || fail "fan pct '$3' > 100"
        exec /usr/local/libexec/nitro-fan "$2" "$3"
        ;;
      *)
        case "$2" in
          ''|*[!0-9]*) fail "fan pct '$2'" ;;
        esac
        [ "$2" -le 100 ] || fail "fan pct '$2' > 100"
        fan_manual_profile
        exec /usr/local/libexec/nitro-fan "$2"
        ;;
    esac
    ;;
esac

case "$1" in
  cpu)
    # cpu GOV EPP TURBO (4 argv; GOV=$2, EPP=$3, TURBO=$4)
    [ "$#" -eq 4 ] || fail "cpu argc=$#"
    case "$2" in powersave|performance|balance_power|balance_performance) ;;
      *) fail "gov '$2'" ;; esac
    case "$3" in power|balance_power|balance_performance|performance) ;;
      *) fail "epp '$3'" ;; esac
    case "$4" in 0|1) ;; *) fail "turbo '$4'" ;; esac
    rc=0
    write_all scaling_governor "$2"                       || rc=1
    write_all energy_performance_preference "$3"          || rc=1
    echo "$4" > /sys/devices/system/cpu/intel_pstate/no_turbo || rc=1
    exit $rc
    ;;
  thermal)
    case "$2" in
      on)  systemctl enable --now nitro-thermal; exit $? ;;
      off) systemctl stop nitro-thermal; exit $? ;;
      *)   fail "thermal '$2'" ;;
    esac
    ;;
  *) fail "cmd '$1'" ;;
esac
exit 1

