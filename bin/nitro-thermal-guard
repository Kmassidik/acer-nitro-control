#!/usr/bin/env bash
# nitro-thermal-guard — emergency turbo cut driven by CPU/GPU temps (runs as root)
#
# The fan curve (nbfc) does the real work: 100% at 88C, and NBFC critical mode
# forces full blast at 84C. This guard is only the last resort, so it must not
# flap — a cut that is undone one poll later just causes stutter.
#
#   default          lvl3 (powersave / balance_performance / turbo on)
#   T >= HOT (88)    -> lvl1 (powersave / power / turbo off), held for >= HOLD
#   T <= COOL (80)   -> back to lvl3, but only after NEED consecutive cool
#                       samples AND at least HOLD seconds since the cut
HOT=88
COOL=80
HOLD=180
NEED=3
POLL=5

set_lvl() {
  local GOV=$1 EPP=$2 TURBO=$3
  for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo $GOV > "$f"; done
  for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo $EPP > "$f"; done
  echo $TURBO > /sys/devices/system/cpu/intel_pstate/no_turbo
  logger -t nitro-thermal "thermal-guard -> lvl ($GOV/$EPP/turbo_off=$TURBO)"
}

LVL=3
CUT=0
COOLN=0
set_lvl powersave balance_performance 0

while true; do
  CPU=0
  for d in /sys/class/hwmon/hwmon*; do
    [ "$(cat $d/name 2>/dev/null)" = "coretemp" ] || continue
    for t in $d/temp*_input; do
      v=$(cat "$t" 2>/dev/null); v=$((v/1000)); [ $v -gt $CPU ] && CPU=$v
    done
  done
  GPU=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')
  [ -z "$GPU" ] && GPU=0
  T=$CPU; [ "$GPU" -gt "$T" ] && T=$GPU
  NOW=$(date +%s)

  if [ "$T" -ge "$HOT" ]; then
    COOLN=0
    if [ "$LVL" -ne 1 ]; then
      LVL=1; CUT=$NOW
      logger -t nitro-thermal "thermal-guard -> CUT at ${T}C (cpu=$CPU gpu=$GPU)"
      set_lvl powersave power 1
    fi
  elif [ "$T" -le "$COOL" ]; then
    COOLN=$((COOLN + 1))
    if [ "$LVL" -eq 1 ] && [ "$COOLN" -ge "$NEED" ] && [ $((NOW - CUT)) -ge "$HOLD" ]; then
      LVL=3; COOLN=0
      logger -t nitro-thermal "thermal-guard -> RESTORE at ${T}C after $((NOW - CUT))s"
      set_lvl powersave balance_performance 0
    fi
  else
    COOLN=0
  fi
  sleep "$POLL"
done
