#!/usr/bin/env bash
# turbo-lvl 1..4|auto — CPU levels for Nitro AN515-58 (root work via nitro-priv)
# MUST match cfg::LEVELS in src/core/config.h (UI reads these exact triples
# back to decide which segment is active — a mismatch shows the wrong segment)
# 1=Quiet 2=Balanced 3=Boost 4=Max   auto=thermal guard
LEVEL_GOV=(powersave powersave powersave performance)
LEVEL_EPP=(power balance_performance performance performance)
LEVEL_TURBO=(1 0 0 0)
PRIV=/usr/local/bin/nitro-priv

case ${1:-3} in
  auto)
    sudo -n "$PRIV" thermal on && echo "auto: guard ON (lvl3 baseline, emergency lvl1 at >=88C, recover <=80C)"
    exit $?
    ;;
  [1-4])
    i=$((10#$1 - 1))
    GOV=${LEVEL_GOV[$i]} EPP=${LEVEL_EPP[$i]} TURBO=${LEVEL_TURBO[$i]}
    ;;
  *) echo "usage: turbo-lvl 1|2|3|4|auto"; exit 1 ;;
esac

sudo -n "$PRIV" thermal off
# Two fan engines, one knob each — measured on Jimny_ADH BIOS V1.11:
#   thermal profile (WMI): the real quiet knob — quiet/balanced idle at
#     ~1800 RPM (true 0-RPM dip after a switch); gaming fan-mode "auto"
#     pins a ~3300 RPM floor, so Quiet/Balanced steer the profile engine.
#   gaming fan mode (facer): turbo polar curve ~6000-7500 RPM — Boost/Max.
case $1 in
  3|4) sudo -n "$PRIV" profile balanced; sudo -n "$PRIV" fanmode turbo ;;
  1)   sudo -n "$PRIV" profile quiet;    sudo -n "$PRIV" fanmode auto  ;;
  2)   sudo -n "$PRIV" profile balanced; sudo -n "$PRIV" fanmode auto  ;;
esac
if sudo -n "$PRIV" cpu "$GOV" "$EPP" "$TURBO"; then
  echo "manual lvl$1 (guard OFF): $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)/$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference)/turbo_off=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo)"
else
  echo "lvl$1: apply failed (see journal for nitro-priv)" >&2
  exit 1
fi
